# Database Configuration (PostgreSQL/PostGIS)
DATABASE_URL=postgresql://appuser:apppassword@localhost:5432/appdb?schema=public

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production

# SMS Gateway (MSG91)
MSG91_KEY=your_msg91_auth_key
MSG91_SENDER_ID=your_msg91_sender_id
MSG91_TEMPLATE_ID=your_msg91_otp_template_id

# Firebase Cloud Messaging (FCM) Credentials (Service Account)
FCM_PROJECT_ID=your-firebase-project-id
FCM_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"

# MinIO Object Storage Credentials
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=raktsetu-bucket
